# Google Cloud TTS 서비스 계정 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-service-account-key.json

# 서버 외부 공개 URL (팟캐스트 앱에서 접근하는 주소)
BASE_URL=https://your-server.com

# 서버 포트 (기본값: 3000)
PORT=3000

# 네이버 블로그 ID
BLOG_ID=ranto28

# 스케줄 (기본: 매일 오전 7시 KST)
# cron 형식: 분 시 일 월 요일
CRON_SCHEDULE=0 7 * * *

# 최대 보관 에피소드 수 (초과 시 오래된 MP3 자동 삭제, 기본값: 30)
MAX_EPISODES=30
